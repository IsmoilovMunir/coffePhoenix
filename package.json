{
  "name": "coffee-phenix-monorepo",
  "private": true,
  "workspaces": [
    "apps/coffee",
    "apps/partniers"
  ],
  "scripts": {
    "dev:coffee": "npm run dev -w apps/coffee",
    "dev:partniers": "npm run dev -w apps/partniers",
    "build:coffee": "npm run build -w apps/coffee",
    "build:partniers": "npm run build -w apps/partniers",
    "build": "npm run build:coffee && npm run build:partniers",
    "preview:coffee": "npm run preview -w apps/coffee",
    "preview:partniers": "npm run preview -w apps/partniers"
  }
}
