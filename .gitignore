.DS_Store
Thumbs.db

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
.cache/
coverage/

# Environment files
.env
.env.*
!.env.example
*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*
*.pid

# IDE/editor
.idea/
.vscode/*
!.vscode/extensions.json

# OS/temp
*.tmp
*.swp

# Deployment/secrets (never commit)
*.pem
*.key
*.crt
*.p12
*.pfx
id_rsa
id_ed25519
known_hosts
authorized_keys

# Local deploy overrides
deploy/*.local.*
scripts/*.local.*

# Vite / frontend caches (не коммитить)
.vite/
**/.vite/

# TypeScript incremental
*.tsbuildinfo

# Spring Boot — локальные конфиги с секретами / машинными URL
**/application-local.yml
**/application-local.properties
**/application-secret.yml
**/application-*-local.yml

# JVM crash dumps / heap
hs_err_pid*.log
replay_pid*.log
*.hprof

# Доп. служебные файлы ОС
.AppleDouble
Desktop.ini
