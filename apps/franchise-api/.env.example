# Скопируйте в .env и подставьте значения.
MAIL_HOST=smtp.timeweb.ru
MAIL_PORT=465
MAIL_SMTP_SSL_ENABLE=true
MAIL_STARTTLS_ENABLE=false

MAIL_USERNAME=
MAIL_PASSWORD=

MAIL_TO=
MAIL_FROM=

# Локальный Vite; в приложении уже разрешены https://*.coffeephoenix.ru. Доп. домены — через запятую.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
